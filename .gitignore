# --- Data ---
# Raw national AQS files are re-downloadable (scripts/download_data.py); never commit.
data/raw/*
!data/raw/.gitkeep

# Processed runtime inputs ARE committed on purpose (they are small): the
# Streamlit Cloud deployment reads them directly, so the app works without
# re-running the 3.3 GB ETL. Everything else in processed/ stays ignored.
data/processed/*
!data/processed/.gitkeep
!data/processed/daily_panel.csv
!data/processed/data_quality_report.csv

# External NLP corpus (1.8 MB, US Federal Register, public domain)
data/external/*
!data/external/.gitkeep
!data/external/federal_register_epa_airquality.json

# --- Database / models ---
# The SQLite database (26 MB) is committed: the dashboard reads the sites
# table from it at runtime.
models/*.pkl
models/*.joblib
models/*.txt

# --- Python ---
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/

# --- Notebooks (executed, ~5 MB each; regenerate with scripts/make_notebooks.py
#     + nbconvert, see README section 5) ---
.ipynb_checkpoints/
notebooks/*.ipynb

# --- Outputs: regenerable, but the small metrics artifacts are committed so
#     results are visible on GitHub and the dashboard's model pages work ---
outputs/*
!outputs/metrics/
outputs/metrics/*
!outputs/metrics/model_comparison.json
!outputs/metrics/regression_results.json
!outputs/metrics/rf_feature_importance.csv
!outputs/metrics/analysis_summary.json

# --- Environment / secrets ---
.env
.streamlit/secrets.toml

# --- OS / editor ---
Thumbs.db
.DS_Store
.idea/
.vscode/
